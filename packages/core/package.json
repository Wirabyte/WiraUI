{
  "name": "@wiraui/core",
  "version": "0.1.0",
  "private": true,
  "description": "WiraUI token engine, exporters and Thai utilities. Framework-free. The Angular builds and the schematics compile this source in (`@wirabyte/ui/core`); dist/ is CommonJS for Node tooling only.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck:ts49": "node node_modules/typescript-49/bin/tsc -p tsconfig.ts49.json"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "typescript-49": "npm:typescript@4.9.5",
    "vitest": "^3.2.4"
  }
}
