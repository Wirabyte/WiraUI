{
  "name": "wiratheme",
  "version": "1.0.0-alpha.0",
  "description": "WiraTheme UI components for Angular 15–17: PrimeNG-style API, Thai-first, themable with SCSS, CSS or TypeScript.",
  "license": "UNLICENSED",
  "keywords": ["angular", "ui", "components", "theme", "design-tokens", "thai"],
  "peerDependencies": {
    "@angular/common": ">=15.0.0 <18.0.0",
    "@angular/core": ">=15.0.0 <18.0.0",
    "rxjs": "^7.4.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "migrations": "./schematics/migration.json"
  }
}
