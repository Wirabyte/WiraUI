{
  "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../dist",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    { "glob": "**/*", "input": "fonts", "output": "fonts" },
    { "glob": "**/*", "input": "svg", "output": "svg" },
    "wiraicon.css",
    "icons.json",
    "README.md",
    "LICENSE"
  ],
  "allowedNonPeerDependencies": ["tslib"]
}
