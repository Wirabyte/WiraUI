{
  "$schema": "http://json-schema.org/schema",
  "$id": "WiraUINgAdd",
  "title": "ng add wiraui",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Project to set up. Default: the first application in angular.json.",
      "$default": {
        "$source": "projectName"
      }
    },
    "style": {
      "type": "string",
      "enum": [
        "auto",
        "scss",
        "css"
      ],
      "default": "auto",
      "description": "How the main theme is loaded.",
      "x-prompt": {
        "message": "How should the main theme be loaded?",
        "type": "list",
        "items": [
          {
            "value": "auto",
            "label": "Detect from the project (recommended)"
          },
          {
            "value": "scss",
            "label": "SCSS: @use 'theme/wiraui.theme' in styles.scss"
          },
          {
            "value": "css",
            "label": "CSS: a .css file in angular.json (CSS, Less and others)"
          }
        ]
      }
    },
    "structure": {
      "type": "string",
      "enum": [
        "auto",
        "module",
        "standalone"
      ],
      "default": "auto",
      "description": "Where provideWiraUI() goes.",
      "x-prompt": {
        "message": "App structure?",
        "type": "list",
        "items": [
          {
            "value": "auto",
            "label": "Detect from main.ts (recommended)"
          },
          {
            "value": "module",
            "label": "NgModule (AppModule)"
          },
          {
            "value": "standalone",
            "label": "Standalone (app.config.ts)"
          }
        ]
      }
    },
    "theme": {
      "type": "string",
      "default": "auto",
      "description": "Theme or preset to start from. auto = this wiraui major's default (v1: sila-light-teal, v2: mali, v3: wira). tools/sync-sources.mjs writes each major's choices into the prompt. Names teams know from other theme sets (lara-light-teal, saga-blue, aura …) are accepted too.",
      "x-prompt": {
        "message": "Theme?",
        "type": "list",
        "items": [
          {
            "value": "auto",
            "label": "This version's default"
          }
        ]
      }
    },
    "utils": {
      "type": "boolean",
      "default": true,
      "description": "Add WiraUI's utility classes (grid, flex, spacing, sizing, colours). They use the class names apps already use (grid, col-12, md:col-6, flex, p-3), so they can replace a separate utility library. Leave out with --utils=false; trim groups later in SCSS.",
      "x-prompt": "Add WiraUI utility classes (grid, flex, spacing)?"
    },
    "primary": {
      "type": "string",
      "default": "",
      "description": "Primary colour as hex. Empty keeps the preset's colour.",
      "x-prompt": "Primary colour hex (empty = preset colour)"
    },
    "font": {
      "type": "string",
      "enum": [
        "auto",
        "Kanit",
        "Sarabun",
        "Prompt",
        "Noto Sans Thai",
        "IBM Plex Sans Thai",
        "Anuphan",
        "Inter",
        "Roboto",
        "none"
      ],
      "default": "auto",
      "description": "Thai font. auto = the preset's font; it is not linked again if the app already loads it.",
      "x-prompt": {
        "message": "Font?",
        "type": "list",
        "items": [
          {
            "value": "auto",
            "label": "Preset's font (skipped if already loaded)"
          },
          "Kanit",
          "Sarabun",
          "Prompt",
          "Noto Sans Thai",
          "IBM Plex Sans Thai",
          "Anuphan",
          "Inter",
          "Roboto",
          {
            "value": "none",
            "label": "Don't set a font"
          }
        ]
      }
    },
    "locale": {
      "type": "string",
      "enum": [
        "th-buddhist",
        "th-gregorian",
        "en"
      ],
      "default": "th-buddhist",
      "x-prompt": {
        "message": "Language and calendar?",
        "type": "list",
        "items": [
          {
            "value": "th-buddhist",
            "label": "Thai, Buddhist calendar (B.E.)"
          },
          {
            "value": "th-gregorian",
            "label": "Thai, Gregorian calendar (A.D.)"
          },
          {
            "value": "en",
            "label": "English"
          }
        ]
      }
    },
    "darkMode": {
      "type": "string",
      "enum": [
        "none",
        "class",
        "media"
      ],
      "default": "none",
      "x-prompt": {
        "message": "Dark mode?",
        "type": "list",
        "items": [
          {
            "value": "none",
            "label": "Off"
          },
          {
            "value": "class",
            "label": "Toggle with the .wu-dark class"
          },
          {
            "value": "media",
            "label": "Follow the OS setting"
          }
        ]
      }
    },
    "angularRange": {
      "type": "string",
      "visible": false,
      "description": "Internal: overrides the supported Angular range read from wiraui's package.json (tests only)."
    },
    "releaseVersion": {
      "type": "string",
      "visible": false,
      "description": "Internal: overrides the version read from wiraui's package.json (tests only)."
    }
  }
}
