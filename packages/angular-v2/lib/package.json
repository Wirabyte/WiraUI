{
  "name": "wiratheme",
  "version": "2.0.0-alpha.0",
  "description": "WiraTheme UI components for Angular 18–20: PrimeNG-style API, Thai-first, themable with SCSS, CSS or TypeScript.",
  "license": "UNLICENSED",
  "keywords": [
    "angular",
    "ui",
    "components",
    "theme",
    "design-tokens",
    "thai"
  ],
  "peerDependencies": {
    "@angular/common": ">=18.0.0 <21.0.0",
    "@angular/core": ">=18.0.0 <21.0.0",
    "rxjs": "^7.4.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "exports": {
    "./theme": {
      "sass": "./theme/_index.scss"
    },
    "./theme/api": {
      "sass": "./theme/_api.scss"
    },
    "./themes/*": {
      "default": "./themes/*"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "migrations": "./schematics/migration.json"
  }
}
