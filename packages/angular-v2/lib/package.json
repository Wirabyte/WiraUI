{
  "name": "@wirabyte/ui",
  "version": "2.0.0-beta.0",
  "description": "WiraUI UI components for Angular 18–20: familiar API, Thai-first, themable with SCSS, CSS or TypeScript.",
  "license": "MIT",
  "homepage": "https://ui.wirabyte.com",
  "bugs": "https://github.com/Wirabyte/WiraUI/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wirabyte/WiraUI.git"
  },
  "keywords": [
    "angular",
    "ui",
    "components",
    "theme",
    "design-tokens",
    "thai"
  ],
  "peerDependencies": {
    "@angular/common": ">=18.0.0 <21.0.0",
    "@angular/core": ">=18.0.0 <21.0.0",
    "@angular/forms": ">=18.0.0 <21.0.0",
    "@angular/router": ">=18.0.0 <21.0.0",
    "chart.js": ">=3.0.0 <5.0.0",
    "rxjs": "^7.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=18.19"
  },
  "sideEffects": false,
  "exports": {
    "./theme": {
      "sass": "./theme/_index.scss"
    },
    "./theme/api": {
      "sass": "./theme/_api.scss"
    },
    "./themes/*": {
      "default": "./themes/*"
    },
    "./utils": {
      "sass": "./utils/_index.scss",
      "style": "./utils/utils.css",
      "default": "./utils/utils.css"
    },
    "./utils/*": {
      "default": "./utils/*"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "migrations": "./schematics/migration.json"
  }
}
