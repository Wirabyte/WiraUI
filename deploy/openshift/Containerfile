# The WiraUI docs site as a static nginx image. Build from the repository root:
#   docker build -f deploy/openshift/Containerfile -t wiraui-docs .
FROM node:24-slim AS build
WORKDIR /src
COPY . .
RUN corepack enable \
  && pnpm install --frozen-lockfile \
  && pnpm pack:all \
  && (cd apps/docs && npm ci --no-audit --no-fund) \
  && pnpm run docs

# Runs under the random non-root UID that OpenShift assigns: this image keeps its writable paths in /tmp.
FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY deploy/openshift/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/docs/dist/docs/browser /usr/share/nginx/html
EXPOSE 8080
